{
  "name": "kb",
  "version": "0.1.0",
  "description": "本地知识库：data/kb/**/*.md → SQLite FTS5(trigram) 索引，提供 kb_search / kb_reindex / kb_stats 与 HTTP 接口",
  "gantry": {
    "entry": "plugin.py",
    "permissions": [
      "tools",
      "api",
      "ui"
    ],
    "contributes": {
      "tools": [
        "kb_search",
        "kb_reindex",
        "kb_stats",
        "kb_embed",
        "kb_add"
      ],
      "api": [
        "GET api/search",
        "POST api/reindex",
        "GET api/stats",
        "GET api/docs",
        "GET api/semantic",
        "POST api/embed",
        "GET api/vector-stats",
        "GET api/local-models",
        "POST api/import",
        "POST api/delete",
        "GET api/inbox",
        "POST api/inbox/scan",
        "GET api/ocr",
        "POST api/ocr"
      ],
      "panels": [
        "kb-status"
      ]
    },
    "config": {
      "dir": "data/kb",
      "max_results": 6,
      "min_score": 0.0,
      "auto_reindex": true
    },
    "allow_uninstall": true
  }
}
