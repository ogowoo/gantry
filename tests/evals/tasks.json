    "task_planned": true,
    "task_run_used": true,
    "files_exist": [
     "eval_sub.txt"
    ],
    "max_steps": 35
   }
  },
  {
   "id": "parallel-subagents",
   "category": "multi-agent-parallel",
   "task": "用 subagent_many 并行完成两个独立分析：一个总结 README.md 的第一节，一个列出当前目录的 Python 文件；汇总后返回 final。",
   "assert": {
    "subagents_used_any": [
     "subagent_many",
